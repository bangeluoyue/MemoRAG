OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
EMBEDDINGS_MODEL_NAME=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=0

HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# 首次初始化管理员时必填（8-128 字符）；不要提交真实值。管理员已存在后不会覆盖其密码。
ADMIN_INITIAL_PASSWORD=
# 至少 32 个字符；更换会使现有会话失效。
SESSION_SECRET=
# 留空时 production 默认启用、本地开发默认关闭；仅按部署协议显式覆盖。
AUTH_COOKIE_SECURE=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_FAILURES=5

# 管理员网页上传 EPUB 的单文件上限（字节，默认 25 MiB）
EPUB_UPLOAD_MAX_BYTES=26214400

DATABASE_URL=
DATABASE_SSL=false

MILVUS_ADDRESS=localhost:19530
MILVUS_TOKEN=
MILVUS_BOOK_COLLECTION=ebook_collection
MILVUS_BOOK_ID=1
MILVUS_NPROBE=16
MILVUS_NOTES_COLLECTION=life_notes

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_NOTES_INDEX=life_notes
NOTES_KEYWORD_K=20
NOTES_VECTOR_K=20

BOOK_NAME=天龙八部
EMBEDDING_DIMENSION=1024
RETRIEVAL_K=8
MAX_RETRIEVALS=8
MAX_CONTEXT_DOCUMENTS=12
MAX_SUB_QUESTIONS=4
MAX_PLAN_REPAIR_ATTEMPTS=1
MAX_SINGLE_RETRIEVALS=2
MAX_GAP_RECOVERY_ATTEMPTS=1
AGENT_TIMEOUT_MS=120000
DECISION_TIMEOUT_MS=15000

ENABLE_RERANK=false
ENABLE_NOTE_RERANK=false
