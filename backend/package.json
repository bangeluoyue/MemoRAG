{
  "name": "memorag-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal EPUB Agentic RAG backend for MemoRAG",
  "scripts": {
    "inspect:milvus": "node src/cli/inspect-milvus.js",
    "ingest:epub": "node src/cli/ingest-epub.js",
    "notes": "node src/cli/notes.js",
    "chat": "node src/cli/chat.js",
    "eval:dataset": "node legacy/eval/build_dataset.mjs",
    "eval:run": "node legacy/eval/run_eval.mjs",
    "start": "node src/http/server.js",
