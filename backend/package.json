    "@langchain/textsplitters": "1.0.2",
    "@lingo-reader/epub-parser": "0.4.6",
    "@zilliz/milvus2-sdk-node": "2.6.17",
    "dotenv": "^18.0.7",
    "html-to-text": "9.0.5",
    "langsmith": "^0.10.11",
    "openevals": "0.2.2",
    "pg": "8.23.1",
    "zod": "^4.6.5"
  }
