# Private server file: /etc/memorag/production.env (root:memorag 0640).
# Load via MEMORAG_ENV_FILE; never source as shell or pass to frontend/Compose.
NODE_ENV=production
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
AUTH_COOKIE_SECURE=true
SESSION_SECRET=
ADMIN_INITIAL_PASSWORD=
# Deployment CLI only: accounts --execute resets tester password and its sessions.
DEPLOY_TESTER_PASSWORD=
AUTH_SESSION_TTL_SECONDS=604800
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_FAILURES=5
EPUB_UPLOAD_MAX_BYTES=26214400

# Neon pooled URL with sslmode=verify-full (copy privately, do not print).
DATABASE_URL=
DATABASE_SSL=true
# Optional direct URL ONLY for migrations; never derive by guessing a hostname.
DATABASE_MIGRATION_URL=

# Zilliz HTTPS endpoint from console, explicit :443 accepted.
MILVUS_ADDRESS=
MILVUS_TOKEN=
MILVUS_BOOK_COLLECTION=ebook_collection
MILVUS_NOTES_COLLECTION=life_notes
MILVUS_BOOK_ID=1
MILVUS_NPROBE=16
EMBEDDING_DIMENSION=1024

ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_NOTES_INDEX=life_notes
NOTES_KEYWORD_K=20
NOTES_VECTOR_K=20

OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=qwen-plus
EMBEDDINGS_MODEL_NAME=text-embedding-v3
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=0
AGENT_TIMEOUT_MS=120000
DECISION_TIMEOUT_MS=15000
RETRIEVAL_K=8
MAX_RETRIEVALS=8
MAX_CONTEXT_DOCUMENTS=12
MAX_SUB_QUESTIONS=4

ENABLE_WEB_SEARCH=false
ENABLE_RERANK=false
ENABLE_NOTE_RERANK=false
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_TRACING_V2=false
ENABLE_NOTE_LANGSMITH_TRACING=false
MEMORAG_LANGSMITH_CONTENT_MODE=metadata_only
